                  "const b = pm.response.json();",
                  "const list = Array.isArray(b) ? b : b.results;",
                  "pm.test('new room is in the list', () => pm.expect(list.some(r => String(r.id) === String(pm.collectionVariables.get('roomId')))).to.eql(true));",
                  "pm.test('room exposes last_message/unread_count fields', () => { const r = list.find(x => String(x.id) === String(pm.collectionVariables.get('roomId'))); pm.expect(r).to.have.property('last_message'); pm.expect(r).to.have.property('unread_count'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{probeAccess}}" }],
            "url": { "raw": "{{apiUrl}}/rooms/", "host": ["{{apiUrl}}"], "path": ["rooms", ""] }
          }
        },
        {
          "name": "Send message to room",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('message body persisted', () => pm.expect(b.content).to.eql('Hello from the Postman collection'));",
                  "pm.collectionVariables.set('messageId', b.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{probeAccess}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": \"{{roomId}}\",\n  \"content\": \"Hello from the Postman collection\"\n}"
            },
            "url": { "raw": "{{apiUrl}}/messages/", "host": ["{{apiUrl}}"], "path": ["messages", ""] }
          }
        },
        {
          "name": "Message with empty content -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('empty message rejected (400/422)', () => pm.expect([400, 422]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{probeAccess}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"room_id\": \"{{roomId}}\",\n  \"content\": \"\"\n}" },
            "url": { "raw": "{{apiUrl}}/messages/", "host": ["{{apiUrl}}"], "path": ["messages", ""] }
          }
        },
        {
          "name": "Room history (as admin, marks read)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('message appears in room history', () => pm.expect(b.some(m => m.content === 'Hello from the Postman collection')).to.eql(true));",
                  "pm.test('incoming message is marked read', () => {",
                  "  const m = b.find(x => x.content === 'Hello from the Postman collection');",
                  "  pm.expect(m.is_read).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access}}" }],
            "url": { "raw": "{{apiUrl}}/rooms/{{roomId}}/messages/", "host": ["{{apiUrl}}"], "path": ["rooms", "{{roomId}}", "messages", ""] }
          }
        },
        {
          "name": "Outsider reads room -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('non-participant cannot fetch room (404)', () => pm.expect(pm.response.code).to.eql(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{probe2Access}}" }],
            "url": { "raw": "{{apiUrl}}/rooms/{{roomId}}/", "host": ["{{apiUrl}}"], "path": ["rooms", "{{roomId}}", ""] }
          }
        },
        {
          "name": "Outsider sends message into room -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('non-participant cannot post into the room (403)', () => pm.expect(pm.response.code).to.eql(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{probe2Access}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"room_id\": \"{{roomId}}\",\n  \"content\": \"I should not be allowed here\"\n}" },
            "url": { "raw": "{{apiUrl}}/messages/", "host": ["{{apiUrl}}"], "path": ["messages", ""] }
          }
        },
        {
          "name": "Messages filtered by room",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const list = Array.isArray(b) ? b : b.results;",
                  "pm.test('only returns messages from this room', () => {",
                  "  pm.expect(list.length).to.be.at.least(1);",
                  "  pm.expect(list.every(m => String(m.room) === String(pm.collectionVariables.get('roomId')))).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{probeAccess}}" }],
            "url": {
              "raw": "{{apiUrl}}/messages/?room_id={{roomId}}",
              "host": ["{{apiUrl}}"],
              "path": ["messages", ""],
              "query": [{ "key": "room_id", "value": "{{roomId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "05 - CORS / deployment",
      "item": [
        {
          "name": "CORS preflight from Netlify origin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('preflight accepted (200)', () => pm.expect(pm.response.code).to.eql(200));",
                  "const allow = pm.response.headers.get('Access-Control-Allow-Origin');",
                  "pm.test('allow-origin echoes the site or is *', () => pm.expect(allow === 'https://skillhubzaa.netlify.app' || allow === '*').to.eql(true));",
                  "pm.test('credentials are allowed', () => pm.expect((pm.response.headers.get('Access-Control-Allow-Credentials') || '').toLowerCase()).to.eql('true'));"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "https://skillhubzaa.netlify.app" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "authorization,content-type" }
            ],
            "url": { "raw": "{{apiUrl}}/token/", "host": ["{{apiUrl}}"], "path": ["token", ""] }
          }
        },
        {
          "name": "CORS preflight from localhost:5173 (dev server)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const allow = pm.response.headers.get('Access-Control-Allow-Origin');",
                  "pm.test('dev origin is allowed', () => pm.expect(allow === 'http://localhost:5173' || allow === '*').to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Access-Control-Request-Method", "value": "GET" }
            ],
            "url": { "raw": "{{apiUrl}}/posts/", "host": ["{{apiUrl}}"], "path": ["posts", ""] }
          }
        }
      ]
    }
  ]
