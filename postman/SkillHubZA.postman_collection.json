{
  "info": {
    "name": "SkillHub ZA API",
    "description": "End-to-end API checks for the SkillHub ZA Django backend: health, auth, posts, comments, likes, chat rooms, messages, authorisation boundaries and CORS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "apiUrl", "value": "http://127.0.0.1:8000/api" },
    { "key": "adminUser", "value": "admin" },
    { "key": "adminPass", "value": "skillhubadmin2026" },
    { "key": "probePass", "value": "Postman!2026Probe" },
    { "key": "probeUser", "value": "" },
    { "key": "probe2User", "value": "" },
    { "key": "access", "value": "" },
    { "key": "refresh", "value": "" },
    { "key": "probeAccess", "value": "" },
    { "key": "probe2Access", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "post2Id", "value": "" },
    { "key": "roomId", "value": "" },
    { "key": "messageId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Smoke",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('database check is ok', () => pm.expect(b.checks.database).to.eql('ok'));",
                  "pm.test('overall status ok', () => pm.expect(b.status).to.eql('ok'));",
                  "pm.test('has a redis check entry', () => pm.expect(b.checks).to.have.property('redis'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiUrl}}/health/", "host": ["{{apiUrl}}"], "path": ["health", ""] }
          }
        },
        {
          "name": "Posts list (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const list = Array.isArray(b) ? b : b.results;",
                  "pm.test('returns a JSON list', () => pm.expect(list).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiUrl}}/posts/", "host": ["{{apiUrl}}"], "path": ["posts", ""] }
          }
        }
      ]
    },
    {
      "name": "02 - Auth",
      "item": [
        {
          "name": "Register probe user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = 'pm_probe_' + Date.now();",
                  "pm.collectionVariables.set('probeUser', u);",
                  "console.log('probe user: ' + u);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('returns access + refresh tokens', () => {",
                  "  pm.expect(b.access).to.be.a('string').and.not.empty;",
                  "  pm.expect(b.refresh).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('username echoes back', () => pm.expect(b.user.username).to.eql(pm.collectionVariables.get('probeUser')));",
                  "pm.collectionVariables.set('probeAccess', b.access);",
                  "pm.collectionVariables.set('refresh', b.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{probeUser}}\",\n  \"email\": \"{{probeUser}}@example.com\",\n  \"password\": \"{{probePass}}\",\n  \"confirm_password\": \"{{probePass}}\",\n  \"role\": \"youth\",\n  \"date_of_birth\": \"2000-01-01\"\n}"
            },
            "url": { "raw": "{{apiUrl}}/auth/register/", "host": ["{{apiUrl}}"], "path": ["auth", "register", ""] }
          }
        },
        {
          "name": "Register duplicate username -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "const b = pm.response.json();",
                  "pm.test('username error reported', () => pm.expect(JSON.stringify(b).toLowerCase()).to.include('username'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{probeUser}}\",\n  \"email\": \"dup-{{probeUser}}@example.com\",\n  \"password\": \"{{probePass}}\",\n  \"confirm_password\": \"{{probePass}}\",\n  \"role\": \"youth\",\n  \"date_of_birth\": \"2000-01-01\"\n}"
            },
            "url": { "raw": "{{apiUrl}}/auth/register/", "host": ["{{apiUrl}}"], "path": ["auth", "register", ""] }
          }
        },
        {
          "name": "Register probe user 2 (outsider)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = 'pm_out_' + Date.now();",
                  "pm.collectionVariables.set('probe2User', u);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('probe2Access', b.access);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{probe2User}}\",\n  \"email\": \"{{probe2User}}@example.com\",\n  \"password\": \"{{probePass}}\",\n  \"confirm_password\": \"{{probePass}}\",\n  \"role\": \"youth\",\n  \"date_of_birth\": \"2000-01-01\"\n}"
            },
            "url": { "raw": "{{apiUrl}}/auth/register/", "host": ["{{apiUrl}}"], "path": ["auth", "register", ""] }
          }
        },
        {
          "name": "Token obtain (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('access token returned', () => pm.expect(b.access).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('access', b.access);",
                  "pm.collectionVariables.set('refresh', b.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPass}}\"\n}"
            },
            "url": { "raw": "{{apiUrl}}/token/", "host": ["{{apiUrl}}"], "path": ["token", ""] }
          }
        },
        {
          "name": "Token obtain (wrong password) -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"definitely-not-the-password\"\n}"
            },
            "url": { "raw": "{{apiUrl}}/token/", "host": ["{{apiUrl}}"], "path": ["token", ""] }
          }
        },
        {
          "name": "Token refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('new access token returned', () => pm.expect(pm.response.json().access).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}" },
            "url": { "raw": "{{apiUrl}}/token/refresh/", "host": ["{{apiUrl}}"], "path": ["token", "refresh", ""] }
          }
        },
        {
          "name": "Users/me (authenticated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns the token owner', () => pm.expect(b.username).to.eql(pm.collectionVariables.get('adminUser')));",
                  "pm.test('never exposes password material', () => {",
                  "  pm.expect(JSON.stringify(b)).to.not.include('pbkdf2_');",
                  "  pm.expect(b).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access}}" }],
            "url": { "raw": "{{apiUrl}}/users/me/", "host": ["{{apiUrl}}"], "path": ["users", "me", ""] }
          }
        },
        {
          "name": "Users/me without token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiUrl}}/users/me/", "host": ["{{apiUrl}}"], "path": ["users", "me", ""] }
          }
        },
        {
          "name": "Users/me with malformed token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not.a.real.token" }],
            "url": { "raw": "{{apiUrl}}/users/me/", "host": ["{{apiUrl}}"], "path": ["users", "me", ""] }
          }
        }
      ]
    },
