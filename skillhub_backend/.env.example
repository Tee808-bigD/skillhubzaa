# Django Settings
DJANGO_SECRET_KEY=skillhub-za-secret-key-change-in-production-2026!
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Allowed Origins (e.g. React Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database (Leave DB_NAME empty to default to SQLite, or fill for PostgreSQL)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=skillhub_db
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=skillhub_za_db
# DB_USER=skillhub_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Redis / Celery (Optional for Phase 2)
REDIS_URL=redis://127.0.0.1:6379/0
