# ==============================================================================
# SkillHub ZA Backend Environment Configuration (.env.example)
# Copy this file to .env in the skillhub_backend directory and adjust values.
# ==============================================================================

# Core Django Settings
SECRET_KEY=django-insecure-skillhub-za-development-only-key-placeholder-994
DJANGO_SECRET_KEY=django-insecure-skillhub-za-development-only-key-placeholder-994
DEBUG=True
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,engrainedly-subinvolute-silvana.ngrok-free.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,engrainedly-subinvolute-silvana.ngrok-free.dev

# Database Configuration (PostgreSQL or SQLite)
# Option A: DATABASE_URL format (e.g., postgres://user:password@localhost:5432/skillhub_db or sqlite:///db.sqlite3)
DATABASE_URL=sqlite:///db.sqlite3
# Option B: Explicit database parameters
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# CORS & CSRF Origins (Allow React Vite frontend & AI Studio)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://aistudio.google.com,https://engrainedly-subinvolute-silvana.ngrok-free.dev
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://aistudio.google.com,https://engrainedly-subinvolute-silvana.ngrok-free.dev

# JWT Token Lifetimes & HttpOnly Cookie Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_AUTH_COOKIE=refresh_token
JWT_AUTH_COOKIE_SECURE=False # Set to True in production (HTTPS)
JWT_AUTH_COOKIE_SAMESITE=Lax
JWT_AUTH_COOKIE_PATH=/api/token/

# Security Headers & Cookies (Set to True in production when using HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Redis / Channel Layer (Optional for distributed WebSockets)
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS_CHANNEL_LAYER=False
